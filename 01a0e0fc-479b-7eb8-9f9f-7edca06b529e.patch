+@Composable
+fun LanguageScreen(
+    viewModel: AppViewModel,
+    onLanguageSelected: () -> Unit
+) {
+    val langs = listOf(
+        "en" to "English",
+        "ta" to "தமிழ்",
+        "hi" to "हिन्दी",
+        "te" to "తెలుగు",
+        "kn" to "ಕನ್ನಡ",
+        "ml" to "മലയാളം"
+    )
+
+    val englishNames = mapOf(
+        "en" to "English",
+        "ta" to "Tamil",
+        "hi" to "Hindi",
+        "te" to "Telugu",
+        "kn" to "Kannada",
+        "ml" to "Malayalam"
