+package `in`.jandwar.app.ai
+
+import `in`.jandwar.app.data.local.AssetDataSource
+import javax.inject.Inject
+import javax.inject.Singleton
+
+@Singleton
+class DeterministicParser @Inject constructor(
+    private val assetDataSource: AssetDataSource
+) : NluExtractor {
+
+    override fun extract(
+        text: String,
+        langCode: String,
+        currentProfile: ProfileFragment?,
+        isOnline: Boolean,
+        callback: NluExtractor.Callback
+    ) {
+        try {
+            val result = parse(text.lowercase())
+            callback.onResult(result)
+        } catch (e: Exception) {
+            callback.onError(e.message ?: "Parse failed")
+        }
+    }
+
+    fun parse(sentence: String): ProfileFragment {
+        val s = sentence.lowercase()
+        val frag = ProfileFragment()
+
+        // Districts
+        try {
+            val districts = assetDataSource.loadDistricts()
+            for (d in districts.all) {
+                if (s.contains(d.lowercase())) {
+                    frag.district = d
+                    break
+                }
+            }
+        } catch (_: Exception) {}
+
+        // Education
+        when {
+            s.contains("below") || s.contains("read") || s.contains("write") || s.contains("5th") || s.contains("class 5") -> frag.edu = "class5"
+            s.contains("8th") || s.contains("class 8") || s.contains("eighth") -> frag.edu = "class8"
+            s.contains("10th") || s.contains("class 10") || s.contains("tenth") || s.contains("sslc") -> frag.edu = "class10"
+            s.contains("12th") || s.contains("class 12") || s.contains("twelfth") || s.contains("hsc") -> frag.edu = "class12"
+            s.contains("graduate") || s.contains("degree") || s.contains("college") || s.contains("bachelor") -> frag.edu = "graduate"
+            s.contains("iti") || s.contains("diploma") -> frag.edu = "class12"
+        }
+
+        // Preference
+        when {
+            s.contains("own") || s.contains("self") || s.contains("business") || s.contains("entrepreneur") || s.contains("my own") -> frag.preference = "pref_self"
+            s.contains("job") || s.contains("wage") || s.contains("employer") || s.contains("salary") || s.contains("company") -> frag.preference = "pref_wage"
+        }
+
+        // Mobility
+        when {
+            s.contains("village") || s.contains("nearby") || s.contains("local") || s.contains("close") -> frag.mobility = "local"
+            s.contains("district") -> frag.mobility = "district"
+            s.contains("anywhere") || s.contains("state") || s.contains("tamil nadu") || s.contains("far") -> frag.mobility = "state"
+        }
+
+        // Interests - keyword mapping
+        val interestKeywords = mapOf(
+            "dairy" to listOf("dairy", "milk", "பால்", "दूध"),
+            "cattle" to listOf("cattle", "cow", "livestock", "மாடு"),
+            "goat" to listOf("goat", "sheep", "ஆடு", "बकरी"),
+            "poultry" to listOf("poultry", "chicken", "egg", "கோழி", "मुर्गी"),
+            "farming" to listOf("farming", "farm", "agriculture", "crop", "விவசாயம்", "खेती"),
+            "food" to listOf("food", "baking", "baker", "cooking", "உணவு"),
+            "machine" to listOf("machine", "operator", "technician", "mechanic", "இயந்திரம்"),
+            "textile" to listOf("textile", "handloom", "weaving", "loom", "நெசவு"),
+            "construction" to listOf("construction", "mason", "building", "கட்டுமானம்"),
+            "tailor" to listOf("tailor", "stitching", "sewing", "தையல்", "सिलाई")
+        )
+
+        for ((key, keywords) in interestKeywords) {
+            for (kw in keywords) {
+                if (s.contains(kw)) {
+                    if (!frag.interests.contains(key)) frag.interests.add(key)
+                    break
+                }
+            }
+        }
+
+        return frag
+    }
+
+    fun validate(fragment: ProfileFragment, originalText: String): ProfileFragment {
+        // Ensure values are within allowed enums
+        val allowedEdu = setOf("none", "class5", "class8", "class10", "class12", "graduate")
+        val allowedPref = setOf("pref_self", "pref_wage", "self_employment", "wage_employment")
+        val allowedMob = setOf("local", "district", "state", "within_village", "within_block", "within_district", "anywhere")
+        val allowedInterests = setOf("dairy", "cattle", "goat", "poultry", "farming", "food", "machine", "textile", "construction", "tailor")
+
+        if (fragment.edu != null && fragment.edu !in allowedEdu) fragment.edu = null
+        if (fragment.preference != null && fragment.preference !in allowedPref) fragment.preference = null
+        if (fragment.mobility != null && fragment.mobility !in allowedMob) fragment.mobility = null
+        fragment.interests = fragment.interests.filter { it in allowedInterests }.toMutableList()
+
+        // If district looks suspicious, keep but try to normalize via asset data
+        return fragment
+    }
+}
