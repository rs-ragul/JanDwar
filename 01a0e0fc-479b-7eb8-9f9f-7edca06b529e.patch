@@ -0,0 +1,181 @@
+package `in`.jandwar.app.ai
+
+import android.os.Handler
+import android.os.Looper
+import okhttp3.*
+import okhttp3.MediaType.Companion.toMediaType
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.IOException
+import java.util.concurrent.TimeUnit
+import javax.inject.Inject
+import javax.inject.Singleton
+
+@Singleton
+class GroqExtractor @Inject constructor(
+    private val aiConfig: AiConfig,
+    private val deterministicParser: DeterministicParser
+) : NluExtractor {
+
+    private val client = OkHttpClient.Builder()
+        .connectTimeout(15, TimeUnit.SECONDS)
+        .readTimeout(20, TimeUnit.SECONDS)
+        .build()
+
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private val jsonType = "application/json; charset=utf-8".toMediaType()
+
+    // Use a model that is actually available on Groq
+    // llama-3.1-8b-instant is fast and free, 70b is also available
+    private val model = "llama-3.1-8b-instant"
+    private val fallbackModel = "llama-3.3-70b-versatile"
+    private val groqUrl = "https://api.groq.com/openai/v1/chat/completions"
+
+    fun isConfigured(): Boolean = aiConfig.groqEnabled()
+
+    override fun extract(
+        text: String,
+        langCode: String,
+        currentProfile: ProfileFragment?,
+        isOnline: Boolean,
+        callback: NluExtractor.Callback
+    ) {
+        if (!isConfigured()) {
+            callback.onError("Groq not configured")
+            return
+        }
+
+        val prompt = buildPrompt(text, currentProfile, langCode)
+        val body = JSONObject().apply {
+            put("model", model)
+            put("messages", JSONArray().apply {
+                put(JSONObject().apply {
+                    put("role", "system")
+                    put("content", "You are a helpful assistant that responds ONLY with valid JSON. No explanation.")
+                })
+                put(JSONObject().apply {
+                    put("role", "user")
+                    put("content", prompt)
+                })
+            })
+            put("temperature", 0.3)
+            put("max_tokens", 500)
+            put("response_format", JSONObject().apply { put("type", "json_object") })
+        }
+
+        val request = Request.Builder()
+            .url(groqUrl)
+            .addHeader("Authorization", "Bearer ${aiConfig.groqApiKey}")
+            .addHeader("Content-Type", "application/json")
+            .post(RequestBody.create(jsonType, body.toString()))
+            .build()
+
+        client.newCall(request).enqueue(object : Callback {
+            override fun onFailure(call: Call, e: IOException) {
+                mainHandler.post { callback.onError("Groq network: ${e.message}") }
+            }
+
+            override fun onResponse(call: Call, response: Response) {
+                try {
+                    val responseBody = response.body?.string() ?: ""
+                    if (!response.isSuccessful) {
+                        // Try to parse error message
+                        try {
+                            val errJson = JSONObject(responseBody)
+                            val errMsg = errJson.optJSONObject("error")?.optString("message") ?: "HTTP ${response.code}"
+                            mainHandler.post { callback.onError("Groq API: $errMsg") }
+                        } catch (_: Exception) {
+                            mainHandler.post { callback.onError("Groq HTTP ${response.code}") }
+                        }
+                        return
+                    }
+
+                    val resp = JSONObject(responseBody)
+                    var content = resp.getJSONArray("choices")
+                        .getJSONObject(0)
+                        .getJSONObject("message")
+                        .getString("content")
+                        .trim()
+
+                    // Strip markdown code fences
+                    if (content.startsWith("```json")) content = content.substring(7).trim()
+                    else if (content.startsWith("```")) content = content.substring(3).trim()
+                    if (content.endsWith("```")) content = content.substring(0, content.length - 3).trim()
+
+                    val start = content.indexOf('{')
+                    val end = content.lastIndexOf('}')
+                    if (start >= 0 && end > start) content = content.substring(start, end + 1)
+
+                    val frag = ProfileFragment()
+                    try {
+                        val outJson = JSONObject(content)
+                        if (outJson.has("edu") && !outJson.isNull("edu")) frag.edu = outJson.optString("edu").takeIf { it.isNotBlank() && it != "null" }
+                        if (outJson.has("preference") && !outJson.isNull("preference")) frag.preference = outJson.optString("preference").takeIf { it.isNotBlank() && it != "null" }
+                        if (outJson.has("district") && !outJson.isNull("district")) frag.district = outJson.optString("district").takeIf { it.isNotBlank() && it != "null" }
+                        if (outJson.has("mobility") && !outJson.isNull("mobility")) frag.mobility = outJson.optString("mobility").takeIf { it.isNotBlank() && it != "null" }
+                        if (outJson.has("interests") && !outJson.isNull("interests")) {
+                            val arr = outJson.optJSONArray("interests")
+                            if (arr != null) {
+                                for (i in 0 until arr.length()) {
+                                    val v = arr.optString(i)
+                                    if (v.isNotBlank()) frag.interests.add(v)
+                                }
+                            }
+                        }
+                        if (outJson.has("next_question_native") && !outJson.isNull("next_question_native")) {
+                            frag.nextQuestion = outJson.optString("next_question_native")
+                        } else if (outJson.has("next_question") && !outJson.isNull("next_question")) {
+                            frag.nextQuestion = outJson.optString("next_question")
+                        }
+                    } catch (e: Exception) {
+                        // If JSON parsing fails, fallback to deterministic
+                        val fallback = deterministicParser.parse(text)
+                        mainHandler.post { callback.onResult(fallback) }
+                        return
+                    }
+
+                    val validated = deterministicParser.validate(frag, text)
+                    mainHandler.post { callback.onResult(validated) }
+                } catch (e: Exception) {
+                    mainHandler.post { callback.onError("Groq parse: ${e.message}") }
+                }
+            }
+        })
+    }
+
+    private fun buildPrompt(userText: String, profile: ProfileFragment?, langCode: String): String {
+        val missing = StringBuilder()
+        if (profile != null) {
+            if (!profile.hasEdu()) missing.append("education, ")
+            if (!profile.hasPref()) missing.append("preference (self-employment vs wage), ")
+            if (!profile.hasInterests()) missing.append("work interests/skills, ")
+            if (!profile.hasDistrict()) missing.append("district in Tamil Nadu, ")
+            if (!profile.hasMobility()) missing.append("mobility (local vs district vs state), ")
+        } else {
+            missing.append("education, preference, interests, district, mobility, ")
+        }
+
+        val safeText = if (userText.isBlank()) "(initial greeting - ask first question)" else userText
+
+        return """
+You are an empathetic AI livelihood assistant interviewing a rural Indian beneficiary for PM-AJAY skilling.
+
+Missing info: $missing
+
+Extract from user's answer and generate next question.
+
+Rules:
+- edu MUST be one of: ["none","class5","class8","class10","class12","graduate"] or null
+- preference MUST be one of: ["pref_self","pref_wage"] or null
+- interests MUST be array from ["dairy","cattle","goat","poultry","farming","food","machine","textile","construction","tailor"] or empty
+- district MUST be a Tamil Nadu district name or null
+- mobility MUST be one of: ["local","district","state"] or null
+- next_question_native MUST be a SHORT warm question (1-2 sentences) in language "$langCode" asking for ONE missing field. Never English if lang is not en. Be conversational.
+
+Respond ONLY valid JSON:
+{"edu": "class10" or null, "preference": "pref_self" or null, "interests": ["dairy"] or [], "district": "Erode" or null, "mobility": "local" or null, "next_question_native": "question in $langCode"}
+
+User answer: "$safeText"
+        """.trimIndent()
+    }
+}
