@@ -0,0 +1,171 @@
+package `in`.jandwar.app.ai
+
+import javax.inject.Inject
+import javax.inject.Singleton
+
+@Singleton
+class TieredNluExtractor @Inject constructor(
+    private val groqExtractor: GroqExtractor,
+    private val deterministicParser: DeterministicParser,
+    private val bhashiniGateway: BhashiniGateway
+) : NluExtractor {
+
+    override fun extract(
+        text: String,
+        langCode: String,
+        currentProfile: ProfileFragment?,
+        isOnline: Boolean,
+        callback: NluExtractor.Callback
+    ) {
+        if (text.isBlank()) {
+            // Initial call with empty text - just generate first question
+            if (isOnline && groqExtractor.isConfigured()) {
+                groqExtractor.extract(text, langCode, currentProfile, true, callback)
+            } else {
+                // Offline: generate first question locally
+                val frag = ProfileFragment()
+                frag.nextQuestion = generateOfflineQuestion(currentProfile, langCode)
+                callback.onResult(frag)
+            }
+            return
+        }
+
+        if (isOnline && groqExtractor.isConfigured()) {
+            // Tier 1: Online Groq
+            if (langCode != "en" && bhashiniGateway.isAvailable()) {
+                // Translate to English first for better NLU, then extract
+                bhashiniGateway.translate(text, langCode, "en", object : BhashiniGateway.TranslateCallback {
+                    override fun onResult(translated: String) {
+                        groqExtractor.extract(translated, langCode, currentProfile, true, object : NluExtractor.Callback {
+                            override fun onResult(fragment: ProfileFragment) {
+                                callback.onResult(deterministicParser.validate(fragment, text))
+                            }
+
+                            override fun onError(reason: String) {
+                                // Fallback to deterministic
+                                val fallback = deterministicParser.parse(text)
+                                callback.onResult(fallback)
+                            }
+                        })
+                    }
+
+                    override fun onError(reason: String) {
+                        // Translation failed, try Groq with original text
+                        groqExtractor.extract(text, langCode, currentProfile, true, object : NluExtractor.Callback {
+                            override fun onResult(fragment: ProfileFragment) {
+                                callback.onResult(deterministicParser.validate(fragment, text))
+                            }
+
+                            override fun onError(reason: String) {
+                                val fallback = deterministicParser.parse(text)
+                                callback.onResult(fallback)
+                            }
+                        })
+                    }
+                })
+            } else {
+                groqExtractor.extract(text, langCode, currentProfile, true, object : NluExtractor.Callback {
+                    override fun onResult(fragment: ProfileFragment) {
+                        callback.onResult(deterministicParser.validate(fragment, text))
+                    }
+
+                    override fun onError(reason: String) {
+                        val fallback = deterministicParser.parse(text)
+                        callback.onResult(fallback)
+                    }
+                })
+            }
+        } else {
+            // Tier 3: Offline deterministic
+            val result = deterministicParser.parse(text)
+            if (result.hasEdu() || result.hasPref() || result.hasDistrict() || result.hasMobility() || result.hasInterests()) {
+                // If we extracted something, add next question
+                val merged = ProfileFragment()
+                currentProfile?.let { merged.merge(it) }
+                merged.merge(result)
+                if (!merged.isComplete()) {
+                    result.nextQuestion = generateOfflineQuestion(merged, langCode)
+                }
+                callback.onResult(result)
+            } else {
+                // Nothing extracted, but still need to ask next question
+                val frag = ProfileFragment()
+                frag.nextQuestion = generateOfflineQuestion(currentProfile, langCode)
+                // Still return empty frag with next question, not error
+                // This prevents blocking the conversation offline
+                if (currentProfile?.isComplete() == true) {
+                    callback.onResult(frag)
+                } else {
+                    // If we have no extraction, still proceed with next question
+                    // Return empty but with question so UI can continue
+                    callback.onResult(frag)
+                }
+            }
+        }
+    }
+
+    private fun generateOfflineQuestion(profile: ProfileFragment?, lang: String): String {
+        val missing = profile?.let {
+            mutableListOf<String>().apply {
+                if (!it.hasEdu()) add("education")
+                if (!it.hasPref()) add("preference")
+                if (!it.hasInterests()) add("interests")
+                if (!it.hasDistrict()) add("district")
+                if (!it.hasMobility()) add("mobility")
+            }
+        } ?: mutableListOf("education", "preference", "interests", "district", "mobility")
+
+        val next = missing.firstOrNull() ?: "interests"
+
+        return when (lang) {
+            "ta" -> when (next) {
+                "education" -> "உங்கள் கல்வி தகுதி என்ன?"
+                "preference" -> "உங்களுக்கு சொந்த தொழில் வேண்டுமா அல்லது வேலை வேண்டுமா?"
+                "interests" -> "உங்களுக்கு எந்த வேலையில் ஆர்வம் உள்ளது?"
+                "district" -> "நீங்கள் எந்த மாவட்டத்தைச் சேர்ந்தவர்?"
+                "mobility" -> "நீங்கள் எவ்வளவு தூரம் பயணம் செய்ய முடியும்?"
+                else -> "மேலும் விவரங்களைச் சொல்ல முடியுமா?"
+            }
+            "hi" -> when (next) {
+                "education" -> "आपकी शिक्षा कितनी है?"
+                "preference" -> "आपको अपना व्यवसाय चाहिए या नौकरी?"
+                "interests" -> "आपको किस काम में रुचि है?"
+                "district" -> "आप किस जिले से हैं?"
+                "mobility" -> "आप कितनी दूर जा सकते हैं?"
+                else -> "क्या आप और बता सकते हैं?"
+            }
+            "te" -> when (next) {
+                "education" -> "మీ విద్యార్హత ఏమిటి?"
+                "preference" -> "మీకు సొంత వ్యాపారం కావాలా లేక ఉద్యోగం కావాలా?"
+                "interests" -> "మీకు ఏ పనిలో ఆసక్తి ఉంది?"
+                "district" -> "మీరు ఏ జిల్లాకు చెందినవారు?"
+                "mobility" -> "మీరు ఎంత దూరం ప్రయాణించగలరు?"
+                else -> "దయచేసి మరిన్ని వివరాలు చెప్పండి?"
+            }
+            "kn" -> when (next) {
+                "education" -> "ನಿಮ್ಮ ಶಿಕ್ಷಣ ಅರ್ಹತೆ ಏನು?"
+                "preference" -> "ನಿಮಗೆ ಸ್ವಂತ ವ್ಯಾಪಾರ ಬೇಕೇ ಅಥವಾ ಕೆಲಸ ಬೇಕೇ?"
+                "interests" -> "ನಿಮಗೆ ಯಾವ ಕೆಲಸದಲ್ಲಿ ಆಸಕ್ತಿ ಇದೆ?"
+                "district" -> "ನೀವು ಯಾವ ಜಿಲ್ಲೆಯವರು?"
+                "mobility" -> "ನೀವು ಎಷ್ಟು ದೂರ ಪ್ರಯಾಣಿಸಬಹುದು?"
+                else -> "ದಯವಿಟ್ಟು ಹೆಚ್ಚಿನ ವಿವರಗಳನ್ನು ನೀಡಿ?"
+            }
+            "ml" -> when (next) {
+                "education" -> "നിങ്ങളുടെ വിദ്യാഭ്യാസ യോഗ്യത എന്താണ്?"
+                "preference" -> "നിങ്ങൾക്ക് സ്വന്തം ബിസിനസ് വേണോ അതോ ജോലി വേണോ?"
+                "interests" -> "നിങ്ങൾക്ക് ഏത് ജോലിയിൽ താൽപ്പര്യമുണ്ട്?"
+                "district" -> "നിങ്ങൾ ഏത് ജില്ലക്കാരനാണ്?"
+                "mobility" -> "നിങ്ങൾക്ക് എത്ര ദൂരം യാത്ര ചെയ്യാൻ കഴിയും?"
+                else -> "കൂടുതൽ വിവരങ്ങൾ പറയാമോ?"
+            }
+            else -> when (next) {
+                "education" -> "What is your education qualification?"
+                "preference" -> "Do you want your own business or a job?"
+                "interests" -> "What kind of work are you interested in?"
+                "district" -> "Which district are you from?"
+                "mobility" -> "How far can you travel for work?"
+                else -> "Could you please tell me more?"
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/in/jandwar/app/data/local/AssetDataSource.kt b/app/src/main/java/in/jandwar/app/data/local/AssetDataSource.kt
